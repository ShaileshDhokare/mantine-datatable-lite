{
  "name": "mantine-datatable-lite-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:lib": "npm run dev -w packages/mantine-datatable-lite",
    "dev:playground": "npm run dev -w playground",
    "build:lib": "npm run build -w packages/mantine-datatable-lite",
    "build:playground": "npm run build -w playground",
    "typecheck": "npm run build:lib && npm run typecheck -w playground",
    "test": "npm run test -w packages/mantine-datatable-lite",
    "test:playground": "npm run test -w playground",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/validate-release.mjs && npm run typecheck && npm test && npm run test:playground && npm run build:playground && npm run check:package",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
