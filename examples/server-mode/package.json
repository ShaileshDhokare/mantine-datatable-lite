{
  "name": "mantine-datatable-lite-server-mode-example",
  "private": true,
  "type": "module",
  "description": "Employee directory: mantine-datatable-lite in server mode with React, Mantine, axios, Express and SQLite.",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:server\" \"npm:client\"",
    "server": "node --watch-path=server server/index.js",
    "client": "vite",
    "seed": "node server/seed.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/dates": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "mantine-datatable-lite": "file:../../packages/mantine-datatable-lite",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
