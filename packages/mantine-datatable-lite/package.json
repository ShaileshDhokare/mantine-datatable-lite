{
  "name": "mantine-datatable-lite",
  "version": "0.1.0-alpha.0",
  "description": "A typed React DataTable for Mantine 9 with sorting, filtering, search, pagination, pinning, selection, and expandable rows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaileshDhokare/mantine-datatable-lite.git",
    "directory": "packages/mantine-datatable-lite"
  },
  "homepage": "https://shaileshdhokare.github.io/mantine-datatable-lite/#/getting-started",
  "bugs": {
    "url": "https://github.com/ShaileshDhokare/mantine-datatable-lite/issues"
  },
  "keywords": ["react", "mantine", "datatable", "table", "typescript"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "THIRD_PARTY_NOTICES"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/validate-release.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0"
  }
}
